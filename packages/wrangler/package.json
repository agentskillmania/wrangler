{
  "name": "@agentskillmania/wrangler",
  "version": "0.1.0",
  "description": "Core library for Wrangler — agent crew orchestration, skill management, and workspace composition.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');const src=path.join('src','spec-plan','skills');const dist=path.join('dist','spec-plan','skills');if(fs.existsSync(src)){fs.mkdirSync(dist,{recursive:true});for(const f of fs.readdirSync(src)){if(f.endsWith('.md')){fs.copyFileSync(path.join(src,f),path.join(dist,f))}}}\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:intg": "vitest run test/integration",
    "test:coverage": "vitest run test/unit --coverage",
    "test:watch": "vitest watch test/unit",
    "demo:code-reviewer": "node --import tsx examples/agent/code-reviewer/demo.ts",
    "demo:travel-concierge": "node --import tsx examples/agent/travel-concierge/demo.ts",
    "demo:tech-evaluation": "node --import tsx examples/crew/tech-evaluation/demo.ts",
    "demo:newsroom": "node --import tsx examples/crew/newsroom/demo.ts",
    "prepublishOnly": "pnpm test:unit && pnpm build"
  },
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentskillmania/wrangler.git",
    "directory": "packages/wrangler"
  },
  "dependencies": {
    "@agentskillmania/colts": "^0.3.0",
    "@agentskillmania/sandbox": "^1.1.3",
    "@mozilla/readability": "^0.6.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "immer": "^11.1.4",
    "isbinaryfile": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "mcporter": "^0.10.2",
    "ripgrep": "^0.3.1",
    "turndown": "^7.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
