{
  "name": "@agentskillmania/wrangler",
  "version": "0.1.0",
  "description": "Core library for Wrangler — agent crew orchestration, skill management, and workspace composition.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host-env/node-host-env": {
      "types": "./dist/host-env/node-host-env.d.ts",
      "import": "./dist/host-env/node-host-env.js"
    },
    "./tools/web": {
      "types": "./dist/tools/web/index.d.ts",
      "import": "./dist/tools/web/index.js"
    },
    "./tools/mcp": {
      "types": "./dist/tools/mcp/index.d.ts",
      "import": "./dist/tools/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');function copyRecursive(src,dest){if(!fs.existsSync(src))return;fs.mkdirSync(dest,{recursive:true});for(const e of fs.readdirSync(src,{withFileTypes:true})){const s=path.join(src,e.name);const d=path.join(dest,e.name);if(e.isDirectory()){copyRecursive(s,d)}else if(e.isFile()&&e.name.endsWith('.md')){fs.copyFileSync(s,d)}}}copyRecursive(path.join('src','spec-plan','skills'),path.join('dist','spec-plan','skills'))\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:intg": "vitest run test/integration",
    "test:coverage": "vitest run test/unit --coverage",
    "test:watch": "vitest watch test/unit",
    "demo:code-reviewer": "node --import tsx examples/agent/code-reviewer/demo.ts",
    "demo:travel-concierge": "node --import tsx examples/agent/travel-concierge/demo.ts",
    "demo:tech-evaluation": "node --import tsx examples/crew/tech-evaluation/demo.ts",
    "demo:newsroom": "node --import tsx examples/crew/newsroom/demo.ts",
    "prepublishOnly": "pnpm test:unit && pnpm build"
  },
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentskillmania/wrangler.git",
    "directory": "packages/wrangler"
  },
  "dependencies": {
    "@agentskillmania/colts": "^0.4.0",
    "@agentskillmania/genui": "^0.1.1",
    "@agentskillmania/llm-client": "^0.4.0",
    "@agentskillmania/sandbox": "^1.3.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mozilla/readability": "^0.6.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "immer": "^11.1.4",
    "isbinaryfile": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "mcporter": "^0.10.2",
    "ripgrep": "^0.3.1",
    "shell-quote": "^1.9.0",
    "turndown": "^7.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
