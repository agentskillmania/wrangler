{
  "name": "@agentskillmania/wrangler-devtool",
  "version": "0.1.0",
  "description": "Devtool library for Wrangler — development tooling and utilities.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wrangler-devtool": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');function copyDir(s,d){if(!fs.existsSync(s))return;fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s)){const sp=path.join(s,f),dp=path.join(d,f);if(fs.statSync(sp).isDirectory())copyDir(sp,dp);else fs.copyFileSync(sp,dp);}};copyDir(path.join('src','skills'),path.join('dist','skills'));copyDir(path.join('src','templates'),path.join('dist','templates'));\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:intg": "vitest run test/integration",
    "test:coverage": "vitest run test/unit --coverage",
    "test:watch": "vitest watch test/unit",
    "prepublishOnly": "pnpm test:unit && pnpm build"
  },
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentskillmania/wrangler.git",
    "directory": "packages/wrangler-devtool"
  },
  "dependencies": {
    "@agentskillmania/colts": "link:../../../colts/packages/colts",
    "@agentskillmania/llm-client": "link:../../../colts/packages/llm-client",
    "@agentskillmania/wrangler": "workspace:*",
    "isomorphic-git": "^1.38.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
