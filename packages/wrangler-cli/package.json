{
  "name": "@agentskillmania/wrangler-cli",
  "version": "0.1.0",
  "description": "CLI tool for Wrangler — manage agent crews from the terminal.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wrangler": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=../../.env dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:intg": "vitest run test/integration",
    "test:coverage": "vitest run test/unit --coverage",
    "test:watch": "vitest watch test/unit",
    "prepublishOnly": "pnpm test:unit && pnpm build"
  },
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentskillmania/wrangler.git",
    "directory": "packages/wrangler-cli"
  },
  "dependencies": {
    "@agentskillmania/colts": "^0.3.0",
    "@agentskillmania/llm-client": "^0.2.2",
    "@agentskillmania/settings-yaml": "^0.3.0",
    "@agentskillmania/wrangler": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "throttleit": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-istanbul": "2",
    "@vitest/coverage-v8": "^2.0.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^29.1.1",
    "react-dom": "18",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
