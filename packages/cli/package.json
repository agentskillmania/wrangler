{
  "name": "@agentskillmania/wrangler-cli",
  "version": "0.1.0",
  "description": "CLI tool for Wrangler — manage agent crews from the terminal.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wrangler": "dist/index.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:intg": "vitest run test/integration",
    "test:coverage": "vitest run test/unit --coverage",
    "test:watch": "vitest watch test/unit",
    "prepublishOnly": "pnpm test:unit && pnpm build"
  },
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentskillmania/wrangler.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@agentskillmania/wrangler-core": "workspace:*",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
