{
  "name": "@agentskillmania/wrangler-core",
  "version": "0.1.0",
  "description": "Core library for Wrangler — agent crew orchestration, skill management, and workspace composition.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:intg": "vitest run test/integration",
    "test:coverage": "vitest run test/unit --coverage",
    "test:watch": "vitest watch test/unit",
    "prepublishOnly": "pnpm test:unit && pnpm build"
  },
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentskillmania/wrangler.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@agentskillmania/colts": "^0.2.2",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "immer": "^11.1.4",
    "js-yaml": "^4.1.0",
    "turndown": "^7.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
